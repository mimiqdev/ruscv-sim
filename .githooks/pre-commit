#!/bin/bash
# Pre-commit Hook for RISC-V ISS Simulator
# 快速检查：格式化 + 编译

set -e  # Exit on error

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# 添加 cargo 到 PATH
export PATH="$HOME/.cargo/bin:$PATH"

# 检查 Rust
if ! command -v cargo &> /dev/null; then
    echo "Rust not found. Skip checks."
    exit 0
fi

# Step 1: cargo fmt (自动修复)
echo "Pre-commit: cargo fmt (auto-fixing)..."
cargo fmt --all

# Step 2: 检查是否有格式改动，自动添加到 staging
if ! git diff --quiet --exit-code; then
    echo "Pre-commit: Staging formatting changes..."
    git add -A
    echo "Pre-commit: Formatting changes staged."
fi

# Step 3: cargo check (快速编译检查)
echo "Pre-commit: cargo check..."
cargo check --all-features

echo "Pre-commit checks done."
