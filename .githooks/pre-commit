#!/bin/bash
# Pre-commit Hook for RISC-V ISS Simulator
# 只格式化暂存的 Rust 文件，避免影响其他未暂存的修改

set -e  # Exit on error

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# 添加 cargo 到 PATH
export PATH="$HOME/.cargo/bin:$PATH"

# 检查 Rust
if ! command -v cargo &> /dev/null; then
    echo "Rust not found. Skip checks."
    exit 0
fi

# Step 1: 提取暂存区中已修改、新增、重命名的 Rust 文件
STAGED_RS_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.rs$' | xargs)

# 如果没有 Rust 文件进入 commit，直接退出
if [ -z "$STAGED_RS_FILES" ]; then
    exit 0
fi

echo "Checking formatting for: $STAGED_RS_FILES"

# Step 2: 调用 rustfmt 对暂存文件进行格式化
rustfmt $STAGED_RS_FILES

# Step 3: 将格式化后的改动重新加入暂存区
git add $STAGED_RS_FILES

# Step 4: cargo check (快速编译检查)
echo "Pre-commit: cargo check..."
cargo check --all-features

echo "Pre-commit checks done."
