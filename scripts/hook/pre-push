#!/bin/bash
# Pre-push Hook for RISC-V ISS Simulator
# 在 push 前强制检查 clippy（确保 CI 通过）

set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# 检查 Rust
if ! command -v cargo &> /dev/null; then
    echo "Rust not found. Skip clippy check."
    exit 0
fi

echo ""
echo "Pre-push: cargo clippy (mandatory check)"
echo "========================================"

# 运行 clippy（严格模式）
CLIPPY_OUTPUT=$(cargo clippy --all-features --all-targets -- -D warnings 2>&1)
CLIPPY_EXIT=$?

if [ $CLIPPY_EXIT -eq 0 ]; then
    echo ""
    echo "✅ Clippy check passed!"
    echo "Ready to push! 🚀"
    echo ""
    exit 0
else
    echo ""
    echo "❌ Clippy check failed!"
    echo ""
    echo "$CLIPPY_OUTPUT" | head -40
    echo ""
    echo "========================================"
    echo "Please fix clippy issues before pushing."
    echo "CI will reject the push otherwise."
    echo "========================================"
    exit 1
fi
