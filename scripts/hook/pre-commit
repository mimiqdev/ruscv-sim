#!/bin/bash
# Pre-commit Hook for RISC-V ISS Simulator

set -e

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

# 检查 Rust
if ! command -v cargo &> /dev/null; then
    echo "Rust not found. Skip checks."
    exit 0
fi

echo "Pre-commit: cargo fmt"
cargo fmt --all -- --check 2>/dev/null || cargo fmt --all

echo "Pre-commit: cargo check"
cargo check --all-features

echo "Pre-commit: cargo clippy (warnings only)"
cargo clippy --all-features --all-targets 2>&1 | head -30 || true

echo "Pre-commit checks done."
